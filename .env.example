# --------------------------------------------------------------------------
# FwdEngine — environment
# Copy to .env.local for development. Never commit .env.local.
# --------------------------------------------------------------------------

# Canonical origin. Used for metadata, OpenGraph URLs, sitemap and robots.
# Defaults to https://fwdengine.com when unset.
NEXT_PUBLIC_SITE_URL=https://fwdengine.com


# --------------------------------------------------------------------------
# Qualification form delivery
#
# The /api/contact route needs ONE of the two channels below. With neither
# configured it returns 503 and tells the visitor to email directly, rather
# than reporting success and discarding the enquiry.
# --------------------------------------------------------------------------

# Option A — email via Resend. All three are required together.
RESEND_API_KEY=
CONTACT_TO_EMAIL=deploy@fwdengine.com
CONTACT_FROM_EMAIL=website@fwdengine.com

# Option B — POST the enquiry as JSON. Slack incoming webhook, CRM, anything
# that accepts a JSON body. Used only when the Resend variables are absent.
CONTACT_WEBHOOK_URL=
